@page
@model CLIWEB.Pages.IndexModel
@{
    ViewData["Title"] = "EurekaBank";
}
<div class="wrap">
    <div class="card">
        <div class="topbar">
            <div class="brand">
                <div class="logo">EB</div>
                <h1>EurekaBank</h1>
            </div>
            <span class="user">Usuario: <strong>@Model.User</strong> &middot; <a class="link" href="/Logout">Salir</a></span>
        </div>

        <h2 class="menu-title">
            Operaciones bancarias
            @if (Model.IsAdmin)
            {
                <span class="admin-chip">ADMIN</span>
            }
        </h2>

        <div class="menu-grid">
            @if (Model.IsAdmin)
            {
                <a href="/Depositar">Depositar</a>
                <a href="/RegistrarCliente">Registrar cliente</a>
                <a href="/RegistrarCuenta">Registrar cuenta</a>
                <a href="/EliminarCuenta">Eliminar cuenta</a>
                <a href="/Cuentas">Cuentas</a>
                <a href="/Clientes">Clientes</a>
            }
            <a href="/Retirar">Retirar</a>
            <a href="/ConsultarSaldo">Consultar saldo</a>
            <a href="/Transferir">Transferir</a>
            <a href="/Movimientos">Movimientos</a>
        </div>
    </div>
</div>
