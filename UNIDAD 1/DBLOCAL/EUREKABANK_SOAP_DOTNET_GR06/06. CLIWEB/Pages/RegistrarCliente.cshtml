@page
@model CLIWEB.Pages.RegistrarClienteModel
@{
    ViewData["Title"] = "Registrar Cliente";
}
<h2>Registrar Cliente</h2>
<form method="post">
    <div><label>Paterno:</label><input type="text" name="Campo1" required /></div>
    <div><label>Materno:</label><input type="text" name="Campo2" required /></div>
    <div><label>Nombre:</label><input type="text" name="Campo3" required /></div>
    <div><label>DNI:</label><input type="text" name="Campo4" required /></div>
    <div><label>Ciudad:</label><input type="text" name="Campo5" required /></div>
    <div><label>Direccion:</label><input type="text" name="Campo6" required /></div>
    <div><label>Telefono:</label><input type="text" name="Campo7" required /></div>
    <div><label>Email:</label><input type="text" name="Campo8" required /></div>
    <div><button type="submit">Registrar</button></div>
</form>
@if(!string.IsNullOrEmpty(Model.Mensaje)) { <p style="color:@(Model.Mensaje.StartsWith("OK") ? "green" : "red")">@Model.Mensaje</p> }
<a href="/Index">Volver</a>
