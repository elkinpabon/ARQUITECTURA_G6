@page
@model CLIWEB.Pages.RegistrarCuentaModel
@{
    ViewData["Title"] = "Registrar Cuenta";
}
<h2>Registrar Cuenta</h2>
<form method="post">
    <div><label>Codigo Cliente:</label><input type="text" name="Campo1" required /></div>
    <div><label>Moneda (01/02):</label><input type="text" name="Campo2" value="01" /></div>
    <div><button type="submit">Registrar</button></div>
</form>
@if(!string.IsNullOrEmpty(Model.Mensaje)) { <p style="color:@(Model.Mensaje.StartsWith("OK") ? "green" : "red")">@Model.Mensaje</p> }
<a href="/Index">Volver</a>
