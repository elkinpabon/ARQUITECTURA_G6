@page
@model CLIWEB.Pages.TransferirModel
@{
    ViewData["Title"] = "Transferir";
}
<h2>Transferir</h2>
<form method="post">
    <div><label>Cuenta Origen:</label><input type="text" name="Campo1" required /></div>
    <div><label>Cuenta Destino:</label><input type="text" name="Campo2" required /></div>
    <div><label>Monto:</label><input type="text" name="Campo3" required /></div>
    <div><label>Moneda (01/02):</label><input type="text" name="Campo4" value="01" /></div>
    <div><button type="submit">Transferir</button></div>
</form>
@if(!string.IsNullOrEmpty(Model.Mensaje)) { <p style="color:@(Model.Mensaje.StartsWith("OK") ? "green" : "red")">@Model.Mensaje</p> }
<a href="/Index">Volver</a>
