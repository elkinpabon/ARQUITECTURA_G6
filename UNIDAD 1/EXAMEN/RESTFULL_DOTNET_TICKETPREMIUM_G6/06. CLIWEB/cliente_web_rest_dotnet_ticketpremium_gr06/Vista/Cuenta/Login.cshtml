@model cliente_web_rest_dotnet_ticketpremium_gr06.Modelo.AutenticacionRequest
@{
    ViewData["Title"] = "Login";
}

<div class="tp-auth-shell row g-0 justify-content-center align-items-stretch">
    <div class="col-lg-10 col-xl-8">
        <div class="row g-0 tp-surface tp-auth-card overflow-hidden">
            <div class="col-md-5 tp-auth-aside p-4 p-lg-5 text-white d-flex flex-column justify-content-between">
                <div>
                    <span class="badge tp-badge rounded-pill mb-3">TicketPremium Web</span>
                    <h1 class="display-6 fw-semibold mb-3">Accede a partidos ecuatorianos.</h1>
                    <p class="text-white-75 mb-0">Consulta disponibilidad, compra boletos y revisa reportes en un flujo limpio y rápido.</p>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <span class="tp-chip bg-white text-primary">Login seguro</span>
                    <span class="tp-chip bg-white text-primary">MVC + REST</span>
                </div>
            </div>
            <div class="col-md-7 p-4 p-lg-5 bg-white">
                <div class="mb-4">
                    <div class="tp-kicker mb-2">Acceso</div>
                    <h2 class="h3 mb-2 fw-semibold">Iniciar sesión</h2>
                    <p class="tp-muted mb-0">Ingresa con tu cuenta para continuar.</p>
                </div>

                @if (ViewBag.Error is not null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post" class="d-grid gap-3">
                    <div>
                        <label asp-for="Usuario" class="form-label">Usuario</label>
                        <input asp-for="Usuario" class="form-control tp-input" autocomplete="username" />
                    </div>
                    <div>
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control tp-input" autocomplete="current-password" />
                    </div>
                    <button class="btn btn-primary btn-lg">Entrar</button>
                    <a class="btn btn-outline-secondary" asp-action="Registro">Crear cuenta</a>
                </form>
            </div>
        </div>
    </div>
</div>
