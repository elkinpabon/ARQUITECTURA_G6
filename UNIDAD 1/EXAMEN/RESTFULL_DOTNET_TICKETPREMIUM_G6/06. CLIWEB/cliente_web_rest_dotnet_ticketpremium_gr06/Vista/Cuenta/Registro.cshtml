@model cliente_web_rest_dotnet_ticketpremium_gr06.Modelo.RegistroUsuarioRequest
@{
    ViewData["Title"] = "Registro";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="tp-surface tp-card-hover p-4 p-md-5">
            <div class="mb-4">
                <div class="tp-kicker mb-2">Registro</div>
                <h2 class="h3 mb-2 fw-semibold">Crear cuenta</h2>
                <p class="tp-muted mb-0">Completa tus datos para activar el acceso.</p>
            </div>
            <div class="card border-0 bg-transparent">
                <div class="card-body p-0">
                @if (ViewBag.Error is not null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form asp-action="Registro" method="post">
                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label">Nombre completo</label>
                        <input asp-for="NombreCompleto" class="form-control tp-input" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label">Usuario</label>
                        <input asp-for="Usuario" class="form-control tp-input" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">Correo</label>
                        <input asp-for="Correo" class="form-control tp-input" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control tp-input" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmarPassword" class="form-label">Confirmar contraseña</label>
                        <input asp-for="ConfirmarPassword" type="password" class="form-control tp-input" />
                    </div>
                    <button class="btn btn-success w-100">Registrarme</button>
                </form>
            </div>
            </div>
        </div>
    </div>
</div>
