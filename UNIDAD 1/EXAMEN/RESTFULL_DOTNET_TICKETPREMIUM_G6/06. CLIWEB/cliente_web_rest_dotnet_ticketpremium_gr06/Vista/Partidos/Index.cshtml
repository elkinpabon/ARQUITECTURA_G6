@model cliente_web_rest_dotnet_ticketpremium_gr06.Modelo.InicioViewModel
@{
    ViewData["Title"] = "Partidos";
}

<div class="card tp-card tp-card-hover">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 mb-1">Partidos disponibles</h2>
                <p class="tp-muted mb-0">Selecciona un partido para ver localidades o iniciar una compra.</p>
            </div>
            <a class="btn btn-primary" asp-controller="Ventas" asp-action="Index">Comprar boletos</a>
        </div>

        <div class="table-responsive">
            <table class="table align-middle tp-table mb-0">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Partido</th>
                        <th>Fecha</th>
                        <th>Lugar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var partido in Model.Partidos)
                    {
                        <tr>
                            <td>@partido.Codigo</td>
                            <td class="fw-semibold">@partido.Descripcion</td>
                            <td>@partido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@partido.Lugar</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Localidades" asp-route-codigoPartido="@partido.Codigo">Localidades</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
