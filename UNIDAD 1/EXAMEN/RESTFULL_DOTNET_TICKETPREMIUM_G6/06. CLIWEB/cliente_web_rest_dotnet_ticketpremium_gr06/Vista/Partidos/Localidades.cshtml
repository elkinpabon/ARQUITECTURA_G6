@model cliente_web_rest_dotnet_ticketpremium_gr06.Modelo.CompraViewModel
@{
    ViewData["Title"] = "Localidades";
}

<div class="tp-hero p-4 p-lg-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="badge tp-badge rounded-pill mb-3">Localidades</span>
            <h1 class="display-6 fw-semibold mb-2">@Model.Partido?.Descripcion</h1>
            <p class="mb-0 text-white-75">@Model.Partido?.Fecha.ToString("dd/MM/yyyy HH:mm") - @Model.Partido?.Lugar</p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a class="btn btn-light btn-lg" asp-controller="Ventas" asp-action="Index" asp-route-codigoPartido="@Model.Partido?.Codigo">Comprar boletos</a>
        </div>
    </div>
</div>

@if (Model.Localidades.Count == 0)
{
            <div class="tp-empty p-4 text-center">No hay localidades disponibles para este partido.</div>
}
else
{
    <div class="row g-3">
        @foreach (var localidad in Model.Localidades)
        {
            <div class="col-md-6 col-lg-3">
                <div class="card tp-card tp-card-hover h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h3 class="h5 mb-0">@localidad.CodigoLocalidad</h3>
                            <span class="tp-chip">Q@localidad.Precio.ToString("N2")</span>
                        </div>
                        <p class="tp-muted mb-4">Disponibilidad: <strong>@localidad.Disponibilidad</strong> boletos</p>
                        <a class="btn btn-sm btn-outline-primary mt-auto" asp-controller="Ventas" asp-action="Index" asp-route-codigoPartido="@Model.Partido?.Codigo">Comprar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
