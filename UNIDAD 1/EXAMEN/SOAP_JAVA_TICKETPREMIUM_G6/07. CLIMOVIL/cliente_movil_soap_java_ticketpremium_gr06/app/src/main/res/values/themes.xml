<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base -->
    <style name="Theme.TicketPremium" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="colorPrimaryVariant">@color/brand_dark_variant</item>
        <item name="colorOnPrimary">@color/text_inverse</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_dark_variant</item>
        <item name="android:windowBackground">@color/brand_light</item>
        <item name="materialButtonStyle">@style/TP.Button</item>
        <item name="materialButtonOutlinedStyle">@style/TP.Button.Outlined</item>
    </style>

    <!-- Botones primarios planos, sin sombra extra -->
    <style name="TP.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TP.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Estilo para tarjetas/secciones de contenido -->
    <style name="TP.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
    </style>

    <!-- Toolbar -->
    <style name="TP.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TP.Toolbar.Title</item>
        <item name="subtitleTextAppearance">@style/TP.Toolbar.Subtitle</item>
    </style>

    <style name="TP.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_inverse</item>
    </style>

    <style name="TP.Toolbar.Subtitle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_on_brand_subtle</item>
    </style>
</resources>
