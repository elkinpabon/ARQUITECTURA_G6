<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_light">

    <!-- ============ Header: barra de marca + identidad ============ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_dark"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/TP.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/brand_dark"
            app:title="TICKETPREMIUM"
            app:titleTextColor="@color/text_inverse"
            app:subtitleTextColor="@color/text_on_brand_subtle"
            app:menu="@menu/menu_main"
            app:popupTheme="@style/Theme.Material3.DayNight" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_dark_variant"
            app:tabIndicatorColor="@color/brand_accent"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/brand_accent"
            app:tabTextColor="@color/text_on_brand_subtle"
            app:tabTextAppearance="@style/TextAppearance.Material3.LabelLarge"
            app:tabMode="scrollable" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
