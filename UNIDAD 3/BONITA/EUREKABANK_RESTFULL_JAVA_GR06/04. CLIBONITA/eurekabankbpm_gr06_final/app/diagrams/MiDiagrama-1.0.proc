            <rightOperand xmi:type="expression:Expression" xmi:id="_restConsultaRight" name="newScript()" content="def c = new URL('http://localhost:8080/eurekabank_restful_java_gr06/api/movimientos?cuenta=' + cuentaOrigen).openConnection(); c.requestMethod = 'GET'; def r = (c.responseCode &gt;= 400 ? c.errorStream : c.inputStream).getText('UTF-8'); if (c.responseCode &gt;= 400) throw new IllegalStateException(r); def movimientos = new groovy.json.JsonSlurper().parseText(r); def filas = movimientos.collect { '&lt;tr&gt;&lt;td&gt;' + it.fechaMovimiento + '&lt;/td&gt;&lt;td&gt;' + it.tipoDescripcion + '&lt;/td&gt;&lt;td&gt;' + it.importeMovimiento + '&lt;/td&gt;&lt;/tr&gt;' }.join(''); '&lt;h3&gt;MOVIMIENTOS CUENTA: ' + cuentaOrigen + '&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;Total: ' + movimientos.size() + ' registros&lt;/strong&gt;&lt;/p&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;th&gt;Fecha&lt;/th&gt;&lt;th&gt;Tipo&lt;/th&gt;&lt;th&gt;Monto&lt;/th&gt;&lt;/tr&gt;' + filas + '&lt;/table&gt;'" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.String" returnTypeFixed="true">
