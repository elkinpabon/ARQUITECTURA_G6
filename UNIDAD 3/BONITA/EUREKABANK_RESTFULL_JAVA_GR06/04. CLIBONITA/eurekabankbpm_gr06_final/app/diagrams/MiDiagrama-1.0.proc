os;background:#1f4e79;color:white;&apos;&gt;&lt;th&gt;N&lt;/th&gt;&lt;th&gt;FECHA&lt;/th&gt;&lt;th&gt;TIPO&lt;/th&gt;&lt;th&gt;IMPORTE&lt;/th&gt;&lt;/tr&gt;&quot;&#xD;&#xA;&#xD;&#xA;    movimientos.each { mov -&gt;&#xD;&#xA;        def tipo = mov.tipoDescripcion?.text()&#xD;&#xA;        if (!tipo) { tipo = mov.codigoTipoMovimiento?.text() }&#xD;&#xA;        resultado += &quot;&lt;tr&gt;&quot;&#xD;&#xA;        resultado += &quot;&lt;td&gt;${mov.numeroMovimiento.text()}&lt;/td&gt;&quot;&#xD;&#xA;        resultado += &quot;&lt;td&gt;${mov.fechaMovimiento.text()}&lt;/td&gt;&quot;&#xD;&#xA;        resultado += &quot;&lt;td&gt;${tipo}&lt;/td&gt;&quot;&#xD;&#xA;        resultado += &quot;&lt;td&gt;${mov.importeMovimiento.text()}&lt;/td&gt;&quot;&#xD;&#xA;        resultado += &quot;&lt;/tr&gt;&quot;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    resultado += &quot;&lt;/table&gt;&quot;&#xD;&#xA;    return resultado&#xD;&#xA;} catch (Exception e) {&#xD;&#xA;    return &quot;&lt;p style=&apos;color:red;&apos;&gt;&lt;strong&gt;Error consultando movimientos:&lt;/strong&gt; ${e.message}&lt;/p&gt;&quot;&#xD;&#xA;}" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT">
