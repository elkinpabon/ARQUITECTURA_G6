<?xml version="1.0" encoding="UTF-8"?>
<project name="ms-rest-common" default="jar" basedir=".">
    <description>Compila la libreria compartida REST con Java 17.</description>
    <property name="src.dir" location="src/java"/>
    <property name="build.dir" location="build"/>
    <property name="classes.dir" location="${build.dir}/classes"/>
    <property name="dist.dir" location="dist"/>
    <property name="jar.file" location="${dist.dir}/ms-rest-common.jar"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false" release="17" encoding="UTF-8"/>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${jar.file}" basedir="${classes.dir}"/>
    </target>
</project>
